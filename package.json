{
  "name": "codeharness",
  "version": "0.1.0",
  "private": true,
  "description": "Hardware-R&D workflow layer on top of DeepSeek Harness",
  "scripts": {
    "setup:win": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "start:win": "powershell -ExecutionPolicy Bypass -File scripts/start.ps1",
    "dsh:web": "dsh --profile codeharness",
    "dsh:dump": "dsh --profile codeharness --dump-config",
    "test": "python -m unittest discover -s tests -v"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.6-alpha.2"
  }
}
